<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="tracker_tamper">
    <Fallback>
      <Sequence>
        <ScriptCondition name="TamperCheck"
                         code="cond_tamper_detected"/>
        <Script name="SendTamperAlert"
                code="action_send_tamper_alert"/>
      </Sequence>
      <Sequence>
        <ScriptCondition name="NewPositionRequested"
                         code="cond_new_position_requested"/>
        <Fallback>
          <Sequence>
            <Script name="GNSSFix"
                    code="action_gnss_fix"/>
            <Script name="SendPosition"
                    code="action_send_position"/>
          </Sequence>
          <Script name="RegisterPositioningFailure"
                  code="action_register_positioning_failure"/>
        </Fallback>
      </Sequence>
      <Script name="Sleep"
              code="action_sleep"/>
    </Fallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel/>

</root>
